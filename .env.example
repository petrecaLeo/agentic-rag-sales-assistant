# Copie este arquivo para .env e coloque a sua chave da API da Anthropic.
# Crie a chave em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: hosts aceitos pelo servidor (padrão: localhost,127.0.0.1).
# ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: liga a documentação automática da API em /docs.
# API_DOCS=1
